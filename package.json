{
  "name": "fps-ai-device-fingerprint",
  "version": "2.0.0",
  "description": "AI-Powered Device Fingerprinting System",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "keywords": [
    "fingerprinting",
    "device-detection",
    "ai",
    "typescript",
    "privacy",
    "security"
  ],
  "author": "SPU Team",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^5.5.0",
    "@types/cookie-parser": "^1.4.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "murmurhash3js": "^3.0.1",
    "terser": "^5.43.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.35.0",
    "@types/cors": "^2.8.13",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/murmurhash3js": "^3.0.7",
    "@types/node": "^20.4.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.0",
    "cross-env": "^10.0.0",
    "eslint": "^8.42.0",
    "glob": "^10.3.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "rimraf": "^5.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
