# -*- mode: python ; coding: utf-8 -*-
# Playwright One-file version - creates a single executable with Playwright support

block_cipher = None

a = Analysis(
    ['src/app.py'],
    pathex=['src'],
    binaries=[],
    datas=[
        ('src/config', 'config'),
        ('src/fps_test', 'fps_test'),
        ('src/utils', 'utils'),
    ],
    hiddenimports=[
        'playwright',
        'playwright.async_api',
        'playwright._impl',
        'playwright._impl._api_structures',
        'playwright._impl._api_types',
        'playwright._impl._browser',
        'playwright._impl._browser_context',
        'playwright._impl._browser_type',
        'playwright._impl._cdp_session',
        'playwright._impl._chromium_browser',
        'playwright._impl._connection',
        'playwright._impl._element_handle',
        'playwright._impl._frame',
        'playwright._impl._locator',
        'playwright._impl._page',
        'playwright._impl._playwright',
        'playwright._impl._sync_base',
        'playwright._impl._transport',
        'requests',
        'beautifulsoup4',
        'fps_test',
        'config',
        'utils',
        'fps_test.login_tests.cross_browser_login_tests',
        'fps_test.attribute_tests.language_tests',
        'fps_test.attribute_tests.user_agent_tests',
        'config.general_config',
        'config.language_config',
        'config.timezone_config',
        'config.user_agent_config',
        'utils.browser_factory',
        'utils.fingerprint_collector',
        'utils.login_helper',
        'utils.test_utils',
    ],
    hookspath=[],
    hooksconfig={},
    excludes=[
        'selenium',
        'webdriver_manager',
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name='fps-playwright-onefile',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
